#!/usr/bin/env bash

gencr() {
  if [ -z "$1" ]; then
    echo "Usage: gencr <dev-username>"
    return 1
  fi

  local dev="$1"
  local raw_branch
  raw_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || true
  local timestamp
  timestamp=$(date +"%Y%m%d-%H%M%S")

  local input_file="$HOME/.claude/code_review_query.md"

  if [ -z "$raw_branch" ]; then
    echo "Error: not in a git repo"
    return 1
  fi

  if [ ! -f "${input_file}" ]; then
    echo "Error: ${input_file} not found"
    return 1
  fi

  # sanitized name used only for output file path — never pass to git commands
  local safe_branch="${raw_branch//\//-}"
  safe_branch="${safe_branch// /-}"

  local base_branch="${CODEREVIEW_BASE_BRANCH:-staging}"

  # escape for sed
  esc() {
    printf '%s\n' "$1" | sed 's/[\/&]/\\&/g'
  }

  local esc_raw_branch
  esc_raw_branch="$(esc "$raw_branch")"
  local esc_safe_branch
  esc_safe_branch="$(esc "$safe_branch")"
  local esc_base_branch
  esc_base_branch="$(esc "$base_branch")"
  local esc_dev
  esc_dev="$(esc "$dev")"
  local esc_timestamp
  esc_timestamp="$(esc "$timestamp")"

  mkdir -p "$HOME/tmp/$dev"

  head -n 1 "${input_file}" | sed \
    -e "s/{raw-branch}/${esc_raw_branch}/g" \
    -e "s/{safe-branch}/${esc_safe_branch}/g" \
    -e "s/{base-branch}/${esc_base_branch}/g" \
    -e "s/{dev-username}/${esc_dev}/g" \
    -e "s/{timestamp}/${esc_timestamp}/g"
}

gencr "$@"
